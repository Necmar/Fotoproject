APP_NAME="Bora Foto"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=nl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=nl_NL

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development uses SQLite. Production (Cloud86/Plesk): MySQL/MariaDB.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=bora_foto
# DB_USERNAME=bora_foto
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production (HTTPS only cookies).
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Database queue: processed by a Plesk cronjob, no permanent worker needed.
# Later on a VPS: QUEUE_CONNECTION=redis with a supervisor-managed worker.
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=300
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Bora Foto ---
# Created by `php artisan db:seed` when both are set (or use `php artisan bora:super-admin`).
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Private disk for uploads and results (later: an S3-compatible disk).
BORA_DISK=local
# Defaults; the Super Admin can change these in the app.
BORA_RETENTION_DAYS=7
BORA_REGISTRATION_ENABLED=false
BORA_JPG_QUALITY=88
BORA_MAX_UPLOAD_MB=25
BORA_AI_ENABLED=true

# Cron via URL (only when Plesk cannot run a PHP script): long random string.
# Plesk > Geplande taken > URL ophalen: https://jouwdomein.nl/cron/<token> iedere minuut.
BORA_CRON_TOKEN=
BORA_WORKER_MAX_TIME=50
BORA_REOPTIMIZE_PER_DAY=300
BORA_CSP=true
TRUSTED_PROXIES=*

# OpenAI (phase 5). Never expose this key to the frontend.
OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-2
# auto | never | always
OPENAI_EDIT_POLICY=auto
OPENAI_VERIFY_EDITS=true
# Changed product detail after an AI edit: repair (original pixels back) or reject
OPENAI_ON_PRODUCT_CHANGE=repair

VITE_APP_NAME="${APP_NAME}"
