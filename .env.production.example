# Production template for Cloud86 / Plesk. Copy to .env on the server and fill in.
# Never commit the real .env. Check afterwards: Super Admin > Overzicht > Systeemcontrole.

APP_NAME="Bora Foto"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://jouwdomein.nl
APP_LOCALE=nl
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=mail.jouwdomein.nl
MAIL_PORT=587
MAIL_SCHEME=null
MAIL_USERNAME=noreply@jouwdomein.nl
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@jouwdomein.nl
MAIL_FROM_NAME="${APP_NAME}"

BORA_DISK=local
BORA_RETENTION_DAYS=7
BORA_REGISTRATION_ENABLED=false
BORA_JPG_QUALITY=88
BORA_MAX_UPLOAD_MB=25
BORA_AI_ENABLED=true
BORA_WORKER_MAX_TIME=50
# Only for cron option B (URL): at least 24 characters, letters/digits/-/_
BORA_CRON_TOKEN=
# Paid AI edits via "Opnieuw optimaliseren": max per photo and per company per day (0 = no limit).
# Default only: the Super Admin changes these under Systeem (per photo: no limit by default).
BORA_REOPTIMIZE_PER_DAY=300
# Content Security Policy header; set to false only to rule it out when debugging
BORA_CSP=true
# "*" = Plesk's nginx proxy. Narrow to proxy IP(s), comma separated, if Apache is reachable directly.
TRUSTED_PROXIES=*

OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_EDIT_POLICY=auto
OPENAI_VERIFY_EDITS=true
